class QuizController extends Controller
{
    private function buildFallbackQuizInsights(?QuizAttempt $attempt, $answers): array
    {
        if (! $attempt) {
            return [
                'strong' => 'Your quiz result was shown, but the saved attempt details are not available yet.',
                'weak' => 'Detailed answer analysis could not be loaded for this attempt.',
                'recommendation' => 'Refresh once to retry loading insights. If it still fails, retake the quiz after resetting the attempt.',
            ];
        }

        $answers = collect($answers ?? []);
        $correctAnswers = $answers->where('is_correct', true)->values();
        $wrongAnswers = $answers->where('is_correct', false)->values();

        $strong = 'You answered '.$attempt->score.' out of '.$attempt->total.' questions correctly.';
        if ($correctAnswers->isNotEmpty()) {
            $correctTopics = $correctAnswers
                ->take(2)
                ->map(fn ($answer) => trim((string) data_get($answer, 'question.question_text', '')))
                ->filter()
                ->map(fn (string $text) => Str::limit($text, 80))
                ->implode(' | ');

            if ($correctTopics !== '') {
                $strong .= ' Strong items: '.$correctTopics.'.';
            }
        }

        $weak = 'No major weak areas were detected from this attempt.';
        if ($wrongAnswers->isNotEmpty()) {
            $weakTopics = $wrongAnswers
                ->take(2)
                ->map(fn ($answer) => trim((string) data_get($answer, 'question.question_text', '')))
                ->filter()
                ->map(fn (string $text) => Str::limit($text, 80))
                ->implode(' | ');

            $weak = $weakTopics !== ''
                ? 'Review these items: '.$weakTopics.'.'
                : 'Some questions were missed and should be reviewed.';
        }

        $recommendation = match (true) {
            $attempt->percentage >= 85 => 'Keep the pace and review the missed items once for retention.',
            $attempt->percentage >= 50 => 'Review the incorrect questions and revisit the related lesson sections before the next attempt.',
            default => 'Revisit the module content first, then retake the quiz with focus on the missed questions.',
        };

        return [
            'strong' => $strong,
            'weak' => $weak,
            'recommendation' => $recommendation,
        ];
    }

    /**
     * Load all questions for a quiz module (used in the Cisco-style quiz page)
     */
    public function getQuestions(Module $module)
    {
        if (! $module->is_quiz) {
            return response()->json([
                'success' => false,
                'message' => 'This is not a quiz module.',
            ], 400);
        }

        $questions = QuizQuestion::where('module_id', $module->id)
            ->orderBy('order')
            ->get();

        if ($questions->isEmpty()) {
            return response()->json([
                'success' => false,
                'message' => 'No questions found for this quiz yet.',
            ], 404);
        }

        $formattedQuestions = $questions->map(function ($q) {
            return [
                'id' => $q->id,
                'question_text' => $q->question_text,
                'options' => $q->options,
                'correct' => $q->correct_option,
            ];
        });

        return response()->json([
            'success' => true,
            'questions' => $formattedQuestions,
            'time_limit' => $module->time_limit ?? 0,   // ← This line was missing
        ]);
    }

